{
  "name": "multer-s3-progress",
  "version": "0.2.0",
  "description": "Multer storage engine for S3 compatible storage that reports real upload progress.",
  "keywords": [
    "multer",
    "multer-s3",
    "storage-engine",
    "s3",
    "r2",
    "minio",
    "upload",
    "progress"
  ],
  "license": "MIT",
  "author": "Eren Yuksel",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erennyuksell/multer-s3-progress.git"
  },
  "homepage": "https://github.com/erennyuksell/multer-s3-progress#readme",
  "bugs": {
    "url": "https://github.com/erennyuksell/multer-s3-progress/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run ci && npm run build"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "multer": "^2.3.0",
    "file-type": ">=17"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@aws-sdk/lib-storage": "^3.997.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "file-type": "^22.1.1",
    "multer": "^2.4.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "peerDependenciesMeta": {
    "file-type": {
      "optional": true
    }
  }
}
